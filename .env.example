APP_NAME="Finance Pro"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=pt
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_PT

# --------------------------------------------------------------------------
# BASE DE DADOS
# --------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=finance_pro
DB_USERNAME=root
DB_PASSWORD=

# --------------------------------------------------------------------------
# STRIPE (PAGAMENTOS E ASSINATURAS)
# --------------------------------------------------------------------------
STRIPE_KEY=pk_test_...
STRIPE_SECRET=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
CASHIER_CURRENCY=eur

# IDs dos Preços criados no Dashboard do Stripe do comprador
STRIPE_PRICE_PLUS=price_...
STRIPE_PRICE_PRO=price_...

# --------------------------------------------------------------------------
# INTELIGÊNCIA ARTIFICIAL (OPENROUTER / GEMINI)
# --------------------------------------------------------------------------
OPENROUTER_API_KEY=sk-or-v1-...
AI_MODEL="google/gemini-2.0-flash-exp:free"

# --------------------------------------------------------------------------
# INTEGRAÇÃO FITNESS (STRAVA / SMARTWATCH)
# --------------------------------------------------------------------------
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REDIRECT_URI="${APP_URL}/fitness/strava/callback"

# --------------------------------------------------------------------------
# CONFIGURAÇÃO DE EMAIL (MAILHOG PARA DESENVOLVIMENTO)
# --------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="support@financepro.com"
MAIL_FROM_NAME="${APP_NAME}"

# --------------------------------------------------------------------------
# SISTEMA (CACHE, QUEUE, SESSION)
# --------------------------------------------------------------------------
SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=public
