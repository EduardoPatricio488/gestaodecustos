# --------------------------------------------------------------------------
# FINANCE PRO IA - CONFIGURAÇÃO GLOBAL
# --------------------------------------------------------------------------
APP_NAME="Finance Pro IA"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Idioma e Localização
APP_LOCALE=pt
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_PT

# --------------------------------------------------------------------------
# BASE DE DADOS (MySQL)
# --------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=finance_pro
DB_USERNAME=root
DB_PASSWORD=

# --------------------------------------------------------------------------
# STRIPE (SUBSRIÇÕES E WEBHOOKS)
# --------------------------------------------------------------------------
STRIPE_KEY=pk_test_...
STRIPE_SECRET=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
CASHIER_CURRENCY=eur
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_BUSINESS=price_...

# --------------------------------------------------------------------------
# INTELIGÊNCIA ARTIFICIAL (OPENROUTER)
# --------------------------------------------------------------------------
OPENROUTER_API_KEY=sk-or-v1-...
AI_MODEL="google/gemini-2.0-flash-exp:free"

# --------------------------------------------------------------------------
# EMAIL
# --------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=smtp.sapo.pt
MAIL_PORT=587
MAIL_SCHEME=tls
MAIL_USERNAME=financeproai@sapo.pt
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=financeproai@sapo.pt
MAIL_FROM_NAME="Finance Pro IA"

# --------------------------------------------------------------------------
# MERCADO FINANCEIRO
# --------------------------------------------------------------------------
YAHOO_API_KEY=
ALPHA_VANTAGE_API_KEY=

# --------------------------------------------------------------------------
# NOTIFICAÇÕES PUSH (VAPID)
# --------------------------------------------------------------------------
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VITE_VAPID_PUBLIC_KEY="${VAPID_PUBLIC_KEY}"

# --------------------------------------------------------------------------
# INTEGRAÇÃO FITNESS (STRAVA)
# --------------------------------------------------------------------------
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REDIRECT_URI="${APP_URL}/fitness/strava/callback"

# --------------------------------------------------------------------------
# INFRAESTRUTURA & PERFORMANCE
# --------------------------------------------------------------------------
SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=public
VITE_HMR_HOST=
