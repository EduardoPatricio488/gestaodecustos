# --------------------------------------------------------------------------
# FINANCE PRO AI - CONFIGURAÇÃO GLOBAL
# --------------------------------------------------------------------------
# Este ficheiro é apenas um template. NUNCA colocar aqui secrets reais.
# Para produção, configurar estes valores no painel do host (ex.: Render).
# --------------------------------------------------------------------------
APP_NAME="Finance Pro IA"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Europe/Lisbon

# Produção: APP_ENV=production, APP_DEBUG=false e APP_URL=https://...

# Idioma e Localização
APP_LOCALE=pt
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_PT

# --------------------------------------------------------------------------
# BASE DE DADOS
# --------------------------------------------------------------------------
# Local: MySQL/Laragon é suportado.
# Produção: usar PostgreSQL/MySQL gerido e credenciais exclusivas de produção.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=finance_pro
DB_USERNAME=root
DB_PASSWORD=
DB_SSLMODE=prefer

# --------------------------------------------------------------------------
# STRIPE (SUBSCRIÇÕES E WEBHOOKS)
# --------------------------------------------------------------------------
# Local/testes: usar chaves TEST.
# Produção: usar chaves LIVE e um STRIPE_WEBHOOK_SECRET próprio do endpoint de produção.
STRIPE_KEY=pk_test_...
STRIPE_SECRET=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
CASHIER_CURRENCY=eur
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_BUSINESS=price_...

# --------------------------------------------------------------------------
# INTELIGÊNCIA ARTIFICIAL (OPENROUTER)
# --------------------------------------------------------------------------
OPENROUTER_API_KEY=
AI_MODEL="google/gemini-2.0-flash-exp:free"

# --------------------------------------------------------------------------
# EMAIL
# --------------------------------------------------------------------------
# Produção recomendada: Resend com domínio verificado.
MAIL_MAILER=resend
RESEND_KEY=
MAIL_FROM_ADDRESS=financeproai@example.com
MAIL_FROM_NAME="Finance Pro IA"

# SMTP opcional para ambientes locais/alternativos.
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_SCHEME=tls
MAIL_USERNAME=
MAIL_PASSWORD=

# --------------------------------------------------------------------------
# MERCADO FINANCEIRO
# --------------------------------------------------------------------------
YAHOO_API_KEY=
ALPHA_VANTAGE_API_KEY=

# --------------------------------------------------------------------------
# NOTIFICAÇÕES PUSH (VAPID)
# --------------------------------------------------------------------------
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VITE_VAPID_PUBLIC_KEY="${VAPID_PUBLIC_KEY}"

# --------------------------------------------------------------------------
# INTEGRAÇÕES OPCIONAIS
# --------------------------------------------------------------------------
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REDIRECT_URI="${APP_URL}/fitness/strava/callback"
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# --------------------------------------------------------------------------
# INFRAESTRUTURA & PERFORMANCE
# --------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=public
VITE_HMR_HOST=

# Produção HTTPS:
# SESSION_SECURE_COOKIE=true
# VITE_HMR_HOST= (deixar vazio; o build de produção não usa HMR)
