# Finance Pro AI — produção
# Este ficheiro é apenas um template. Nunca colocar secrets reais no Git.
APP_NAME="Finance Pro IA"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://financepro.com
APP_TIMEZONE=Europe/Lisbon
APP_LOCALE=pt
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_PT

# Gerar APP_KEY com: php artisan key:generate
APP_KEY=

DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
DB_SSLMODE=prefer

# Secrets — configurar exclusivamente no painel do host
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=
OPENROUTER_API_KEY=
RESEND_KEY=
YAHOO_API_KEY=
ALPHA_VANTAGE_API_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_ENCRYPT=true

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=public

# Off-site encrypted database backups
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-west-1
AWS_BUCKET=
AWS_ENDPOINT=
BACKUP_S3_PREFIX=finance-pro-ai/backups

# Dados legais públicos (preencher antes de produção)
LEGAL_COMPANY_NAME=
LEGAL_TAX_NUMBER=
LEGAL_ADDRESS=
LEGAL_EMAIL=

# Limites operacionais
API_RATE_LIMIT=60
PUBLIC_RATE_LIMIT=120
AI_RATE_LIMIT=20
AI_MONTHLY_TOKEN_LIMIT=100000
AI_CONNECT_TIMEOUT=5
AI_REQUEST_TIMEOUT=30
HTTP_CONNECT_TIMEOUT=5
HTTP_TIMEOUT=15
UPLOAD_MAX_MB=10

LEGAL_PHONE=